{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.js"
    },
    {
      "source": "/api/setup",
      "destination": "/api/setup.js"
    },
    {
      "source": "/api/addon",
      "destination": "/api/addon.js"
    },
    {
      "source": "/api/addon/:path*",
      "destination": "/api/addon.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/addon.js"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/api/addon.js"
    },
    {
      "source": "/stream/:path*",
      "destination": "/api/addon.js"
    }
  ]
}
